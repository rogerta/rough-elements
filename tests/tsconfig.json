// Configuration for test files in the tests/ directory.
//
// The root tsconfig.json is configured specifically for building and publishing
// library declaration files (`rootDir: "./src"`, `outDir: "./dist"`,
// `emitDeclarationOnly: true`, `isolatedDeclarations: true`).
//
// Including test files in the root config would trigger `rootDir` errors (TS6059),
// emit unwanted `.d.ts` files for tests into `dist/`, and enforce library-level
// `isolatedDeclarations` rules on test code.
//
// This config extends the root options while disabling declaration emit (`noEmit: true`),
// relaxing `isolatedDeclarations`, and expanding `rootDir` so IDEs and `tsc --noEmit`
// can type-check tests cleanly.
//
// `exclude` must be overridden: the root tsconfig.json excludes `**/*.test.ts`
// and `**/*.spec.ts` so test files never reach the published declarations, and
// `exclude` is inherited through `extends` when not overridden.  Without this
// override, every `.test.ts` file was silently dropped from this project and
// never type-checked.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": null,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "isolatedDeclarations": false
  },
  "exclude": [],
  "include": [
    "./**/*",
    "../src/**/*"
  ]
}
